{
  "name": "bolt",
  "private": true,
  "version": "1.0.0",
  "description": "BOLT — UPSC CSE AI Preparation Platform",
  "author": "BOLT",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "electron:compile": "tsc -p tsconfig.electron.json && node scripts/prepare-electron-dist.mjs",
    "desktop:dev": "concurrently -k \"npm:dev\" \"npm run electron:compile && cross-env BOLT_APP_URL=http://localhost:3000 electron .\"",
    "desktop:build": "npm run electron:compile",
    "desktop:package": "npm run desktop:build && electron-builder --dir --config build/electron-builder.yml",
    "desktop:dist": "npm run desktop:build && electron-builder --config build/electron-builder.yml",
    "desktop:installer": "npm run desktop:dist -- --win nsis",
    "build": "node -e \"const fs=require('fs');const s=fs.readFileSync('server/currentAffairsPipeline.ts','utf8');if(!s.includes('export async function loadCurrentAffairsFromFirestore')){console.error('BUILD GUARD: loadCurrentAffairsFromFirestore export missing from server/currentAffairsPipeline.ts on this commit - repo is out of sync with the intended fix.');process.exit(1)}console.log('Build guard passed.')\" && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "python:server": "python3 main.py --serve",
    "python:cli": "python3 main.py",
    "python:test": "python3 main.py --test",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:security": "tsx scripts/verify-security-isolation.ts",
    "test:acceptance": "tsx scripts/run-acceptance-tests.ts",
    "benchmark": "tsx scripts/run-bolt-benchmark.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
