# ==============================
# BOLT - Git Ignore
# ==============================

# Environment / secrets
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx

# Firebase / service-account credentials
service-account*.json
firebase-service-account*.json
*-service-account*.json
*service-account*.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
dist/
dist-electron/
build/
release/
out/
*.tgz

# Vite / Electron
.vite/
electron-builder.yml.bak

# Logs
logs/
*.log
firebase-debug.log*
firebase-debug.*.log*

# Runtime / local data
data/
*.db
*.sqlite
*.sqlite3
*.pid
*.seed
*.pid.lock

# Local AI / generated models
models/
*.gguf
*.bin
*.safetensors

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# Coverage
coverage/
.nyc_output/

# Firebase local cache
.firebase/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Windows
*.lnk

# IDE
.vscode/
.idea/
*.swp
*.swo

# Claude / local AI tooling
.claude/
.agents/

# Temporary files
*.tmp
*.temp
*.bak
*.old

# Local secrets / credentials
secrets/
credentials/
private/
certs/

# Repository Firebase configuration
!.firebaserc
!firebase.json
!firestore.rules
!firestore.indexes.json

