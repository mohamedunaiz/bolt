# ==============================
# BOLT - Environment Template
# ==============================

# Application
BOLT_JWT_SECRET=
BOLT_ALLOW_TEST_TOKENS=false
ENABLE_DEV_CLI=false
BOLT_APP_URL=http://localhost:3000
NEWS_CRON_SECRET=
# Vercel Cron (vercel.json "crons") authenticates with this value. Set it in Vercel
# project env vars; /api/news/sync accepts either CRON_SECRET or NEWS_CRON_SECRET.
CRON_SECRET=
SCHEDULER_TRIGGER_SECRET=

# Firebase Admin / Server
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=

# Firebase Web / Vite
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# AI Providers
ANTHROPIC_API_KEY=
COHERE_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
LOCAL_AI_ENDPOINT=
LOCAL_AI_MODEL=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
PERPLEXITY_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Local storage
VECTOR_DB_PATH=
# --- Auth hardening (required in production) ---
# Signs BOLT session tokens. REQUIRED in production; without it session tokens are disabled.
# Generate one with: openssl rand -hex 32   (never reuse the old default; it was public)
# (set the existing BOLT_JWT_SECRET variable above)
# Local development ONLY, when no Firebase Admin credentials are configured: accept unverified
# Firebase ID tokens. Ignored when NODE_ENV=production or on Vercel. Leave unset otherwise.
BOLT_ALLOW_UNVERIFIED_FIREBASE_TOKENS=
