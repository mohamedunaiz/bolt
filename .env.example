# ============================================================================
# BOLT UPSC Platform — Environment Configuration Template
# Copy to .env for local development. Never commit real secrets to Git.
# ============================================================================

# --- Frontend (Vite Client-Safe Configuration) ---
VITE_API_BASE_URL=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# --- Server & Cloud Run Runtime ---
NODE_ENV=development
PORT=8080
BOLT_APP_URL=
ALLOWED_ORIGINS=

# --- Firebase Admin & Firestore (Server-Side) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_API_KEY=

# --- Authentication & Security ---
BOLT_JWT_SECRET=
BOLT_ALLOW_TEST_TOKENS=
ENABLE_DEV_CLI=

# --- News & Scheduled Ingestion ---
NEWS_SYNC_SECRET=
CRON_SECRET=
SCHEDULER_TRIGGER_SECRET=
RSS_FETCH_TIMEOUT_MS=10000
DISABLE_INPROCESS_SCHEDULER=
ENABLE_INPROCESS_SCHEDULER=

# --- AI Providers (Server-Side Only) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
COHERE_API_KEY=
NVIDIA_API_KEY=
LOCAL_AI_ENDPOINT=
LOCAL_AI_MODEL=
VECTOR_DB_PATH=
