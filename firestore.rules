rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin status is derived exclusively from Firebase custom claims
    // (set server-side via setAdminCustomClaim / the Admin SDK). No email
    // is ever hardcoded here — grant/revoke admin by setting the claim.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // User profiles and all user-private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Direct root collections partitioned by userId
    match /syllabus/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /progress/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /studyLogs/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /mainsEvaluations/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /documents/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /chatHistory/{userId} {
      allow read, write: if isOwner(userId);
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public connectivity health probe
    match /test/{docId} {
      allow read: if true;
    }

    // Public / verified daily current affairs and published MCQs (read-only for students, admin-only write)
    match /current_affairs/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /daily_mcqs/{mcqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Shared model registry versions (read-only for students, admin-only write)
    match /model_registry/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public curriculum Knowledge Graph (read-only for all students, admin-only write for updates)
    match /knowledge_nodes/{nodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /knowledge_edges/{edgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /knowledge_clusters/{clusterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Background jobs isolated by ownerId or admin access
    match /backgroundJobs/{jobId} {
      allow read, write: if isAuthenticated() && (
        resource == null ||
        resource.data.ownerId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
