{
  "buildCommand": "npm run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/news/daily-current-affairs.ts": {
      "maxDuration": 60,
      "includeFiles": ".vercel-build/**"
    },
    "api/news/sync.ts": {
      "maxDuration": 60,
      "includeFiles": ".vercel-build/**"
    },
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
